{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:all",
  "outputDirectory": "public_build",
  "crons": [
    {
      "path": "/api/cron/publish-insights",
      "schedule": "0 0 * * 1-5"
    }
  ],
  "redirects": [
    {
      "source": "/report",
      "destination": "/report/",
      "permanent": true
    },
    {
      "source": "/insights/_scheduled/:path*",
      "destination": "/insights/",
      "statusCode": 404
    },
    {
      "source": "/insights/zentoshin-payment-readiness",
      "destination": "/insights/zentoshin",
      "permanent": true
    },
    {
      "source": "/insights/zentoshin-payment-readiness/",
      "destination": "/insights/zentoshin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/go/:short_id",
      "destination": "/api/go/:short_id"
    },
    {
      "source": "/report/p/:path*",
      "destination": "/report/index.html"
    },
    {
      "source": "/report/partner-preview",
      "destination": "/report/index.html"
    },
    {
      "source": "/report/partner-preview/",
      "destination": "/report/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  }
}
