# Agent Readiness Insights v2 — Buffer
# Copy to .env (never commit .env). GitHub Actions uses Secrets.

# Buffer GraphQL API token — https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=

# Organization ID — node scripts/list-buffer-channels.mjs
BUFFER_ORGANIZATION_ID=

# Primary channel for ARI Insights LinkedIn queue (usually LinkedIn)
BUFFER_CHANNEL_ID=

# Per-service channel IDs (engineer@coas.asia example)
BUFFER_CHANNEL_ID_LINKEDIN=
BUFFER_CHANNEL_ID_TWITTER=
BUFFER_CHANNEL_ID_FACEBOOK=

# Set to true to save posts as drafts instead of scheduling (local testing)
BUFFER_SAVE_TO_DRAFT=false

# IndexNow — https://www.indexnow.org/documentation
# GitHub Actions: optional Secret INDEXNOW_KEY (publish continues if unset)
# Vercel: Environment Variable INDEXNOW_KEY (generates public_build/{key}.txt at build)
INDEXNOW_KEY=

# Private ABIS Impact Watch — Slack Incoming Webhook (server/CI only; never VITE_)
# GitHub Actions: Secret ABIS_SLACK_WEBHOOK_URL
ABIS_SLACK_WEBHOOK_URL=

# OpenAI Image API — Diagram Gate (scripts/generate-diagram-image.mjs)
# Never commit .env. Use --dry-run locally without these keys.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Vercel Cron — strict 10:00 JST Insights publish (api/cron/publish-insights.js)
# Set on Vercel Production only. Never commit real values.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=CME0358/AI_readiness_index
