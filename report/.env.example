# ─────────────────────────────────────────────────────────────
# Agent Readiness Index — サーバー専用環境変数（サンプル）
#
# このファイルをコピーして .env（ローカル）を作成、または
# Vercel のプロジェクト設定 > Environment Variables に登録する。
#
# 重要: これらは「サーバー専用」キー。VITE_ / NEXT_PUBLIC_ を付けないこと。
#       付けるとビルド時にクライアントへ露出し、キーが盗まれる。
# 1つも設定しない場合は DEMO モード（ダミーレポート）で動作する。
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...

# ─────────────────────────────────────────────────────────────
# Airtable 蓄積（会社名・URL・メール・診断結果を1行追加）
# 3つとも設定したときのみ書き込む。未設定なら蓄積をスキップ。
#   AIRTABLE_API_KEY    Personal Access Token（pat... / scope: data.records:write）
#   AIRTABLE_BASE_ID    app... で始まる Base ID
#   AIRTABLE_TABLE_NAME テーブル名（既定: Leads）
# ─────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Leads

# ─────────────────────────────────────────────────────────────
# Company Report Bundle — 公開 Stripe Payment Link（client build-time）
#
# Public Stripe Payment Link URL for Company Report Bundle (¥29,800 + Research).
# Safe for client bundle — Vite exposes VITE_* at build time.
# Do NOT put STRIPE_SECRET_KEY under VITE_.
# ─────────────────────────────────────────────────────────────
VITE_COMPANY_REPORT_BUNDLE_PAYMENT_URL=

# ─────────────────────────────────────────────────────────────
# Stripe — サーバー専用（/api/verify-purchase）
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# Optional strict Company Report identity fallback when the Stripe Payment Link
# does not set product metadata or client_reference_id. Server-only.
COMPANY_REPORT_STRIPE_PAYMENT_LINK_ID=plink_...
